    "Suspended: no study session asks this card.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgesetzt: Keine Lernsitzung fragt diese Karte ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αναστολή: καμία συνεδρία μελέτης δεν ρωτά αυτή την κάρτα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлена: ни одна учебная сессия не спрашивает эту карточку."
          }
        }
      }
    },
    "Swipe farther, in the direction of the arrow: the card leaves once you pass the threshold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische weiter in Richtung des Pfeils: Die Karte verschwindet erst ab einer bestimmten Strecke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε πιο μακριά, προς την κατεύθυνση του βέλους: η κάρτα φεύγει μόλις περάσεις το όριο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахни дальше в направлении стрелки: карточка уйдёт, когда ты пройдёшь порог."
          }
        }
      }
    },
    "Swipes": {
      "localizations": {
        "de": {
