    "This isn't an Anki package, or the file is damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Anki-Paket, oder die Datei ist beschädigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν είναι πακέτο Anki ή το αρχείο είναι κατεστραμμένο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не пакет Anki, либо файл повреждён."
          }
        }
      }
    },
    "This place has no Trash, so “%@” was moved to the folder “%@” next to it. Files can put it back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es keinen Papierkorb, deshalb wurde „%1$@“ in den Ordner „%2$@“ daneben verschoben. In „Dateien“ kannst du ihn zurückholen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ δεν υπάρχει Κάδος απορριμμάτων, γι' αυτό η τράπουλα «%@» μετακινήθηκε στον φάκελο «%@» δίπλα της. Μπορείς να την επαναφέρεις από την εφαρμογή «Αρχεία»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нет Корзины, поэтому колода «%@» перемещена в папку «%@» рядом. Вернуть её можно в «Файлах»."
          }
        }
      }
    },
    "Three laps of the ring in a day": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Runden des Rings an einem Tag"
          }
        },
        "el": {
