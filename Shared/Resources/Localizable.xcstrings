    "Add %lld Cards": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Karte hinzufügen"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Karten hinzufügen"
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Προσθήκη %lld κάρτας"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Προσθήκη %lld καρτών"
                }
              }
            }
          }
