    "When off, you grade every review yourself, e.g. as Easy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, bewertest du jede Abfrage selbst, z. B. als „Leicht“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ανενεργό, βαθμολογείς εσύ κάθε επανάληψη, π.χ. ως «Εύκολο»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, каждую оценку ставишь ты, например «Легко»."
          }
        }
      }
    },
