      }
    },
    "Cards with the same word key belong to one word, like the two directions of a translation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten mit demselben Wortschlüssel gehören zu einem Wort, etwa die beiden Richtungen einer Übersetzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάρτες με το ίδιο κλειδί λέξης ανήκουν σε μία λέξη, όπως οι δύο κατευθύνσεις μιας μετάφρασης."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки с одним ключом слова относятся к одному слову, например два направления одного перевода."
          }
        }
      }
    },
    "Cards you keep forgetting show up here.": {
