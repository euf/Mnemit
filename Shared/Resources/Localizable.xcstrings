    "Meaning → Word cards": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten „Bedeutung → Wort“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάρτες «σημασία → λέξη»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки «значение → слово»"
          }
        }
      }
    },
    "Meaning → Word cards have a limit of their own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten „Bedeutung → Wort“ haben ein eigenes Limit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κάρτες «σημασία → λέξη» έχουν δικό τους όριο."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У карточек «значение → слово» свой лимит."
          }
        }
      }
    },
    "Meaning → Word unlocks once Word → Meaning is learned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bedeutung → Wort“ wird freigeschaltet, sobald „Wort → Bedeutung“ gelernt ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Σημασία → λέξη» ξεκλειδώνει όταν μαθευτεί το «Λέξη → σημασία»"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Значение → слово» откроется, когда будет выучено «Слово → значение»"
          }
        }
      }
    },
    "Meaning → Word waits until Word → Meaning has this interval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bedeutung → Wort“ wartet, bis „Wort → Bedeutung“ dieses Intervall hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Σημασία → λέξη» περιμένει μέχρι το «Λέξη → σημασία» να έχει αυτό το διάστημα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Значение → слово» ждёт, пока у «Слово → значение» не будет такого интервала."
          }
        }
      }
    },
    "Meaning → Word waits until Word → Meaning reaches the interval in Unlock after. A word is asked one way a day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bedeutung → Wort“ wartet, bis „Wort → Bedeutung“ das Intervall bei „Freischalten nach“ erreicht. Ein Wort wird am Tag nur in einer Richtung gefragt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Σημασία → λέξη» περιμένει μέχρι το «Λέξη → σημασία» να φτάσει το διάστημα του «Ξεκλείδωμα μετά από». Μια λέξη ρωτιέται προς μία κατεύθυνση την ημέρα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Значение → слово» ждёт, пока «Слово → значение» не достигнет интервала из «Открыть после». Слово спрашивают в день в одну сторону."
          }
        }
      }
    },
