    "“%@” contains no rows with a question and an answer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält keine Zeilen mit Frage und Antwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν περιέχει γραμμές με ερώτηση και απάντηση."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» нет строк с вопросом и ответом."
          }
        }
      }
    },
    "“%@” could not be opened. Try again when its file has finished syncing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ließ sich nicht öffnen. Versuche es wieder, wenn die Datei fertig synchronisiert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα της τράπουλας «%@». Δοκίμασε ξανά όταν ολοκληρωθεί ο συγχρονισμός του αρχείου της."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть колоду «%@». Попробуй ещё раз, когда файл закончит синхронизироваться."
          }
        }
      }
    },
    "“%@” could not be read as a MacVocTrain 1 document.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht als MacVocTrain-1-Dokument gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν ήταν δυνατό να διαβαστεί ως έγγραφο MacVocTrain 1."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не удалось прочитать как документ MacVocTrain 1."
          }
        }
      }
    },
    "“%@” has no cards Mnemit can import.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält keine Karten, die Mnemit importieren kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν έχει κάρτες που μπορεί να εισαγάγει το Mnemit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» нет карточек, которые Mnemit может импортировать."
          }
        }
      }
    },
    "“%@” holds no Mnemit decks. Choose the Mnemit folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält keine Mnemit-Stapel. Wähle den Mnemit-Ordner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν περιέχει τράπουλες Mnemit. Επίλεξε τον φάκελο Mnemit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» нет колод Mnemit. Выбери папку Mnemit."
          }
        }
      }
    },
    "“%@” holds no Mnemit decks. Choose the folder with your decks in it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält keine Mnemit-Stapel. Wähle den Ordner, in dem deine Stapel liegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν περιέχει τράπουλες Mnemit. Επίλεξε τον φάκελο με τις τράπουλές σου."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» нет колод Mnemit. Выбери папку, в которой лежат твои колоды."
          }
        }
      }
    },
