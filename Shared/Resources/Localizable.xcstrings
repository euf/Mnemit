    "Mnemit keeps your cards and progress in iCloud Drive, so your iPhone and Mac stay in step.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnemit speichert deine Karten und deinen Fortschritt in iCloud Drive, damit iPhone und Mac auf dem gleichen Stand bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mnemit αποθηκεύει τις κάρτες και την πρόοδό σου στο iCloud Drive, ώστε το iPhone και το Mac να είναι πάντα συγχρονισμένα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnemit хранит твои карточки и прогресс в iCloud Drive, чтобы iPhone и Mac были синхронизированы."
          }
        }
      }
    },
    "Mnemit lays out a few minutes' worth of cards every day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mnemit legt jeden Tag Karten für ein paar Minuten bereit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε μέρα το Mnemit απλώνει κάρτες για λίγα λεπτά."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый день Mnemit раскладывает карточки на несколько минут."
          }
        }
      }
    },
