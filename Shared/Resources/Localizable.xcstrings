    "Target recall: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angestrebte Abrufquote: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στόχος ανάκλησης: %@"
          }
        },
