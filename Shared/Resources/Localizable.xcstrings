    "Cards falling due in the next 30 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten, die in den nächsten 30 Tagen fällig werden."
          }
        },
        "el": {
          "stringUnit": {
