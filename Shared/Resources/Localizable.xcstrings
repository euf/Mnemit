          }
        }
      }
    },
    "Decks are created in Mnemit on the Mac. Choose the Mnemit folder in iCloud Drive, or open a single deck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel werden in Mnemit auf dem Mac angelegt. Wähle den Mnemit-Ordner in iCloud Drive oder öffne einen einzelnen Stapel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τράπουλες δημιουργούνται στο Mnemit στο Mac. Επίλεξε τον φάκελο Mnemit στο iCloud Drive ή άνοιξε μία μεμονωμένη τράπουλα."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колоды создаются в Mnemit на Mac. Выбери папку Mnemit в iCloud Drive или открой одну колоду."
