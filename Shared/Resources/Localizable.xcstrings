    "Touch the card to see the answer, then swipe toward the arrow.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühre die Karte, um die Antwort zu sehen, und wische dann in Pfeilrichtung."
          }
        },
        "el": {
