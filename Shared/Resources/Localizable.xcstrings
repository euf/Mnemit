    "Add decks in Files, under On My iPhone → Mnemit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Stapel in der Dateien-App ab, unter „Auf meinem iPhone“ → Mnemit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τράπουλες στην εφαρμογή «Αρχεία», στο «Στο iPhone μου» → Mnemit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляй колоды в приложении «Файлы», в разделе «На iPhone» → Mnemit."
          }
        }
      }
    },
    "Add the words you are learning.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Wörter hinzu, die du lernst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τις λέξεις που μαθαίνεις."
