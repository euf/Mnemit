        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь слова, которые ты учишь."
          }
        }
      }
    },
    "Add your first cards one by one or from a list.": {
      "localizations": {
        "de": {
          "stringUnit": {
